{
  "permissions": {
    "allow": [
      "Read(/inputs/metadata/**)",
      "Read(/inputs/private/simulated/**)"
    ],
    "deny": [
      "Read(/inputs/private/raw/**)",
      "Edit(/inputs/private/raw/**)",
      "Read(/inputs/private/intermediate/**)",
      "Edit(/inputs/private/intermediate/**)",
      "Read(/inputs/private/final/**)",
      "Edit(/inputs/private/final/**)",
      "Read(/outputs/private/**)",
      "Edit(/outputs/private/**)",
      "Edit(/inputs/private/simulated/**)",
      "Read(/.env)",
      "Read(../secure/**)",
      "Edit(../secure/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "./inputs/private/raw",
        "./inputs/private/intermediate",
        "./inputs/private/final",
        "./outputs/private",
        "./.env",
        "../secure"
      ],
      "denyWrite": [
        "./inputs/private/raw",
        "./inputs/private/intermediate",
        "./inputs/private/final",
        "./outputs/private",
        "./inputs/private/simulated",
        "../secure"
      ]
    }
  }
}
